# AI Video Factory Pro V2 — .env.example  (KOPYALA: cp .env.example .env ; .env ASLA git'e eklenmez)
# ---- zorunlu (üretim) ----
ENV=prod
SECRET_KEY=                      # python -c "import secrets;print(secrets.token_urlsafe(48))"
ENCRYPTION_KEY=                  # python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
DOMAIN=video.example.com         # Caddy otomatik HTTPS için; PUBLIC_BASE_URL otomatik https://DOMAIN olur
POSTGRES_PASSWORD=
MINIO_ROOT_PASSWORD=
ALLOW_REGISTRATION=false         # ilk hesabı oluşturduktan sonra kapatın
# ---- geliştirme (docker kullanmadan) ----
# DATABASE_URL=sqlite:///./data/dev.db   veya postgresql://user:pass@localhost:5432/aivf
# REDIS_URL=redis://localhost:6379/0
# CELERY_EAGER=true              # Redis/worker olmadan süreç içi (yalnızca dev)
# STORAGE_BACKEND=local          # local | s3
# ---- AI sağlayıcı anahtarları (isteğe bağlı: uygulamadan kullanıcı başına da girilebilir; DB'de şifreli saklanır) ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
FAL_KEY=
RUNWAY_API_KEY=
REPLICATE_API_TOKEN=
ELEVENLABS_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
# model adları (sağlayıcılar model kapattığı için yapılandırılabilir)
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_TTS_MODEL=gpt-4o-mini-tts
ANTHROPIC_TEXT_MODEL=claude-sonnet-5-5
FAL_I2V_MODEL=fal-ai/kling-video/v3/pro/image-to-video
FAL_T2V_MODEL=fal-ai/kling-video/v3/pro/text-to-video
RUNWAY_MODEL=gen4_turbo
REPLICATE_VIDEO_MODEL=           # owner/name — kullanıcı seçer
# ---- sosyal medya OAuth uygulamaları ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# ---- push (FCM, isteğe bağlı) ----
FCM_SERVICE_ACCOUNT_JSON=        # servis hesabı JSON içeriği veya dosya yolu
# ---- politika / bütçe varsayılanları ----
ALLOW_OFFLINE_PROVIDERS=true     # false: AI anahtarı yoksa üretim reddedilir (yerel şablon/robotik ses kullanılmaz)
DEFAULT_DAILY_BUDGET_USD=5
DEFAULT_MONTHLY_BUDGET_USD=100
DEFAULT_PER_VIDEO_BUDGET_USD=2
# PRICING_OVERRIDES_JSON={"video:fal:default":{"per_second":0.2}}
